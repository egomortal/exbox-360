    {
      "authored_utf8": "  // Bounded live metadata, including per-handle enumeration results. Existing\n"
    },
    {
      "authored_utf8": "  // Entry pointers stay stable; no unsafe cache eviction while files are open.\n"
    },
    {
      "authored_utf8": "  bool TryRetainEntry() {\n"
    },
    {
      "authored_utf8": "    size_t count=retained_entries_.load();\n"
    },
    {
      "authored_utf8": "    while (count<65536) if (retained_entries_.compare_exchange_weak(count,count+1)) return true;\n"
    },
    {
      "authored_utf8": "    return false;\n"
    },
    {
      "authored_utf8": "  }\n"
    },
    {
      "authored_utf8": "  void ReleaseEntry() { retained_entries_.fetch_sub(1); }\n"
    },
    {
      "authored_utf8": "  size_t retained_entry_count"
    },
    {
      "copy": "upstream",
      "offset": 1456,
      "length": 18
    },
    {
      "authored_utf8": "retained_entries_.load(); }\n"
    },
