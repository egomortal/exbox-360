	mkdir -p build
	$(HOSTCXX) -std=c++17 -O2 -Wall -Wextra -Imodules/host_bridge $(SRC) -o $@ $$(pkg-config --cflags --libs sdl2 SDL2_ttf SDL2_image)

glyphs:
	python3 tools/make_shiny_glyphs.py

