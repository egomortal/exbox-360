SDK ?= /opt/ps5-payload-sdk
CC := $(SDK)/bin/prospero-clang++
SRC := modules/editor_dashboard/bridge.cpp modules/avatar_editor/native/return_ticket.cpp modules/avatar_editor/native/ticket_file.cpp main.cpp dash_model.cpp ps5_library.cpp modules/host_bridge/nxe_bridge.cpp
HDR := modules/editor_dashboard/bridge.hpp system_data.hpp $(wildcard modules/system_data/*.hpp) dash_model.hpp dashboard_layout.hpp media_transport_layout.hpp dashboard_updates.hpp image_resample.hpp era_chrome.hpp xbox_input.hpp ps5_library.hpp
HDR += xui_image.hpp xui_raster_avx2.hpp xui_text.hpp xui_viewport.hpp xui_composite.hpp xui_runtime.hpp xui_renderer.hpp xui_navigation.hpp
HDR += $(wildcard ui/*.inc.hpp assets/*.inc.hpp runtime/*.inc.hpp)
HDR += blades_rail_roles.hpp subtitles.hpp music_metadata.hpp custom_scene_playback.hpp
HDR += network_state.hpp network_runtime.hpp welcome_model.inc.hpp achievements_model.inc.hpp
LIB := $(SDK)/target/user/homebrew/lib
INC := $(SDK)/target/user/homebrew/include
HOSTCXX ?= g++

all: build/eboot.elf

build/eboot.elf: $(SRC) $(HDR) avatar_kit.hpp
	mkdir -p build
	$(CC) -std=c++17 -O2 -Wall -Wextra -D__PROSPERO__ -I$(INC) -Imodules/host_bridge $(SRC) -o $@ \
		-L$(LIB) -lSDL2_ttf -lSDL2_image -lSDL2 -lfreetype -lharfbuzz -lpng -ljpeg -lwebpdemux -lwebp -lz -lbz2 -lsamplerate -liconv \
		-lSceSystemService -lSceUserService -lScePad -lSceAudioOut -lSceVideoOut -lSceKeyboard -lSceImeDialog -lkernel_sys

# Unit tests for the Xbox mapping and the dashboard model. No SDL or SDK needed.
test: build/test_dash build/test_library build/test-xui build/test-ad-profiles
	./build/test_dash
	./build/test_library
	./build/test-xui private/era-skins/blades/scene/[0-9]*.nxui
	./build/test-ad-profiles private/promotions build/ad-profile-test.tsv

build/test_dash: tests/test_dash.cpp dash_model.cpp $(HDR)
	mkdir -p build
	$(HOSTCXX) -std=c++17 -Wall -Wextra -Werror -O1 tests/test_dash.cpp dash_model.cpp -o $@

build/test_library: tests/test_library.cpp ps5_library.cpp $(HDR)
	mkdir -p build
	$(HOSTCXX) -std=c++17 -Wall -Wextra -Werror -O1 tests/test_library.cpp ps5_library.cpp -o $@

build/test-ad-profiles: tests/test_ad_profiles.cpp dash_model.cpp $(HDR)
	mkdir -p build
	$(HOSTCXX) -std=c++17 -Wall -Wextra -Werror -O1 tests/test_ad_profiles.cpp dash_model.cpp -o $@

build/test-blades-rails: tests/test_blades_rails.cpp blades_rail_roles.hpp
	mkdir -p build
	$(HOSTCXX) -std=c++17 -Wall -Wextra -Werror -O1 tests/test_blades_rails.cpp -o $@ $$(pkg-config --cflags --libs sdl2)

build/bake-blades-source: tools/bake_blades_source.cpp xui_renderer.hpp xui_runtime.hpp xui_navigation.hpp xui_viewport.hpp xui_text.hpp xui_composite.hpp xui_raster_avx2.hpp
	mkdir -p build
	$(HOSTCXX) -std=c++17 -O2 -Wall -Wextra -pthread tools/bake_blades_source.cpp -o $@ $$(pkg-config --cflags --libs sdl2 SDL2_ttf SDL2_image)

