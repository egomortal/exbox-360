# AV2 optional module boundary. Run 1 probes layout only; ReXGlue is not linked.
AV2SRC := modules/avatar_editor/avatar_editor.cpp
AV2HDR := modules/avatar_editor/avatar_editor.h
AV2FLAGS := -std=c++17 -O2 -Wall -Wextra -Werror
HOSTAR ?= ar
PS5AR ?= $(SDK)/bin/llvm-ar

avatar-editor-host: build/avatar-editor/host/libavatar-editor.a build/avatar-editor/host/probe
avatar-editor-ps5: build/avatar-editor/ps5/libavatar-editor.a build/avatar-editor/ps5/probe.elf

build/avatar-editor/host/module.o: $(AV2SRC) $(AV2HDR)
	mkdir -p $(@D)
	$(HOSTCXX) $(AV2FLAGS) -c $(AV2SRC) -o $@

build/avatar-editor/ps5/module.o: $(AV2SRC) $(AV2HDR)
	mkdir -p $(@D)
	$(CC) $(AV2FLAGS) -D__PROSPERO__ -I$(INC) -c $(AV2SRC) -o $@

build/avatar-editor/host/libavatar-editor.a: build/avatar-editor/host/module.o
	$(HOSTAR) rcs $@ $<

build/avatar-editor/ps5/libavatar-editor.a: build/avatar-editor/ps5/module.o
	$(PS5AR) rcs $@ $<

build/avatar-editor/host/probe: tools/avatar_editor/probe.cpp $(AV2HDR) build/avatar-editor/host/libavatar-editor.a
	$(HOSTCXX) $(AV2FLAGS) $< build/avatar-editor/host/libavatar-editor.a -o $@

build/avatar-editor/ps5/probe.elf: tools/avatar_editor/probe.cpp $(AV2HDR) build/avatar-editor/ps5/libavatar-editor.a
	$(CC) $(AV2FLAGS) -D__PROSPERO__ -I$(INC) $< build/avatar-editor/ps5/libavatar-editor.a -o $@ -lkernel_sys

build/avatar-editor/host/test: tests/test_avatar_editor.cpp $(AV2HDR) build/avatar-editor/host/libavatar-editor.a
	$(HOSTCXX) $(AV2FLAGS) $< build/avatar-editor/host/libavatar-editor.a -o $@

test-avatar-editor: build/avatar-editor/host/test
	./build/avatar-editor/host/test

.PHONY: avatar-editor-host avatar-editor-ps5 test-avatar-editor
