  "source_transforms": [
    {
      "role": "mesa-source",
      "path": "meson.build",
      "old": "  dep_clang = cpp.find_library('clang-cpp', dirs : llvm_libdir, required : false)\n",
      "new": "# AV2 private host build: reuse installed versioned Clang without writing a system symlink.\n  dep_clang = cpp.find_library('clang-cpp', dirs : [llvm_libdir, '/tmp/exbox-av2-q2-prefix/lib'], required : false)\n",
      "why": "The editor builder pins the Mesa meson.build with this one-line host-build change (an extra library search folder for Clang's libclang-cpp). Applied exactly, then checked against the builder's hash."
    }
  ],
  "source_wraps": [
    {
      "role": "mesa-source",
      "wrap": "subprojects/zlib.wrap",
      "why": "Mesa's own wrap file pins zlib 1.3.1 (zlib.net) and its Meson WrapDB build patch by SHA-256; the builder pins the resulting files."
    }
  ]
