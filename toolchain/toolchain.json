      "commit": "b83202be73e930050e00de0f1b4d9ec46c0391bf",
      "licence": "GPL-3.0"
    },
    {
      "role": "vulkan-port-source",
      "git": "https://github.com/mihawk-99/PS5_Vulkan.git",
      "commit": "f410e67a0241b3e8edcdbcd2a9b285dfc4a412ed",
      "licence": "GPL-3.0"
    },
    {
      "role": "glm-source",
      "git": "https://github.com/g-truc/glm.git",
      "commit": "6f14f4792a0cde5d0cf2c910506724d61cb95834",
      "licence": "MIT / Happy Bunny"
    },
    {
      "role": "fast-float-source",
      "git": "https://github.com/fastfloat/fast_float.git",
      "commit": "50a80a73ab2ab256ba1c3bf86923ddd8b4202bc7",
      "licence": "Apache-2.0 / MIT / BSL-1.0"
    },
    {
      "role": "avatar_editor",
      "git": "https://github.com/panedivitasei/AvatarEditorRecomp.git",
      "commit": "c7910196da96d0c5b6e3170f77c3c928156a214c",
      "licence": "none stated upstream; fetched by you from its official page, not redistributed by Ex-Box"
    }
  ],
  "user_supplied_sources": [
    {
      "role": "rexglue_sdk",
      "upstream": "https://github.com/rexglue/rexglue-sdk.git",
      "commit": "c94f5ebdcb3c9d1a460ca48e04f9758448f8d518",
      "submodules": true,
      "why_not_fetched": "Its source code contains the Xbox 360 executable decryption key (src/system/xex_module.cpp). Ex-Box Setup never downloads keys, so you supply this folder yourself.",
      "also_builds": "host-tools/rexglue"
    },
    {
      "role": "xex-tool",
      "upstream": "https://github.com/mrtitanic777/XexTool-RE.git",
      "commit": "c421d3772ff9b6d5cd4798edbc01f7d0570f1081",
      "submodules": false,
      "why_not_fetched": "Its source code contains the Xbox 360 executable decryption keys (src/crypto/keys.cpp). Ex-Box Setup never downloads keys, so you supply this folder yourself."
    }
  ],
  "native_sdk": {
    "fork_role": "payload-sdk-source",
    "base_release": "https://github.com/ps5-payload-dev/sdk/releases/download/v0.44/ps5-payload-sdk.zip",
    "base_release_sha256": "4d06eab777bb135705b5a6816688c9132efb246093fe606ac488ab6cf65ca5b0",
    "base_prefix": "ps5-payload-sdk/",
    "addons": {
      "url": "https://github.com/ps5-payload-dev/pacbrew-repo/releases/download/v0.41.1/ps5-payload-dev.tar.gz",
      "sha256": "e811bc2e4676c5bb7f80a8fe928d2985dce599996a5ca6b54da3e72699287887",
      "subtree": "opt/ps5-payload-sdk/"
    },
    "fork_overlay": [
      [
        "include/freebsd/",
        "target/include/"
      ],
      [
        "include/khronos/",
        "target/include/"
      ],
      [
        "include/ps5/",
        "target/include/ps5/"
      ],
      [
        "platform/include/ps5platform/",
        "target/include/ps5platform/"
      ],
      [
        "host/bin/prospero-clang",
        "bin/prospero-clang"
      ],
      [
        "host/bin/prospero-clang++",
        "bin/prospero-clang++"
      ]
    ],
    "wrapper_fixes": [
      [
        "bin/prospero-clang",
        "$($SCRIPT_DIR/prospero-llvm-config --version",
        "$(\"$SCRIPT_DIR/prospero-llvm-config\" --version"
      ],
      [
        "bin/prospero-clang++",
        "$($SCRIPT_DIR/prospero-llvm-config --version",
        "$(\"$SCRIPT_DIR/prospero-llvm-config\" --version"
      ],
      [
        "bin/prospero-lld",
        "LDSCRIPT=\"-T${PS5_PAYLOAD_SDK}/ldscripts/elf_x86_64.x\"",
        "LDSCRIPT=(-T \"${PS5_PAYLOAD_SDK}/ldscripts/elf_x86_64.x\")"
      ],
      [
        "bin/prospero-lld",
        "LDSCRIPT=\"\"",
        "LDSCRIPT=()"
      ],
      [
        "bin/prospero-lld",
        "$PIE $LDSCRIPT --eh-frame-hdr",
        "$PIE \"${LDSCRIPT[@]}\" --eh-frame-hdr"
      ]
    ],
    "why": "The SDK the editor builder was pinned against: the official payload SDK v0.44 release, the official pacbrew-repo v0.41.1 bundle installed over it (its libc++abi.a and libunwind.a replace the SDK's), the PS5 fork's headers and compiler wrappers copied on top, and three quoting fixes so the wrappers work in folders with spaces. The editor builds its own platform library from source."
  },
