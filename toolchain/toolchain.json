{
  "schema": 1,
  "description": "Pinned build tools for the Avatar Editor builder (and the dashboard's native build). Every item comes from its official upstream at an exact commit or a SHA-256-checked release file. Nothing here is rehosted by Ex-Box.",
  "layout": "Matches avatar-editor/local-builder/README.md: sources/, native-sdk/, payload-sdk/, llvm21/, dxc/, native-tools/, host-tools/, python/",
  "platform": {
    "distro": "Ubuntu",
    "release": "24.04",
    "apt_base": [
      "build-essential",
      "git",
      "curl",
      "wget",
      "unzip",
      "xz-utils",
      "rsync",
      "util-linux",
      "cmake",
      "ninja-build",
      "bison",
      "flex",
      "pkg-config",
      "zlib1g-dev",
      "python3",
      "python3.12-venv",
      "python3-pil",
      "python3-mako",
      "python3-yaml",
      "spirv-tools"
    ],
    "apt_base_why": "Compilers, build systems and Python modules used to build the tools below. python3-pil must be Ubuntu 24.04's Pillow 10.2.0 (FreeType 2.13.2, raqm 0.10.1): the editor's companion images are checked against hashes made with exactly that build.",
    "llvm": {
      "repo": "https://apt.llvm.org",
      "suite": "llvm-toolchain-noble-21",
      "key_url": "https://apt.llvm.org/llvm-snapshot.gpg.key",
      "version": "1:21.1.8~++20251221032922+2078da43e25a-1~exp1~20251221153059.70",
      "packages": [
        "clang-21",
        "lld-21",
        "llvm-21",
        "llvm-21-dev",
        "llvm-21-tools",
        "libclang-cpp21",
        "libclang-cpp21-dev",
        "libclang-rt-21-dev"
      ],
      "prefix": "/usr/lib/llvm-21",
      "why": "Clang 21.1.8 (commit 2078da43, the llvmorg-21.1.8 tag) compiles the editor. The exact package build is pinned so the compiled editor matches the validated one."
    }
  },
  "sources": [
    {
